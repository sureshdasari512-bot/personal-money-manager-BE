NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pmm
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# false on local HTTP. Set true only when the API is served over HTTPS.
COOKIE_SECURE=false
BCRYPT_COST=10
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=yourname@gmail.com
SMTP_PASS=replace-with-gmail-app-password
EMAIL_FROM=Personal Money Manager <yourname@gmail.com>
REDIS_URL=rediss://default:replace-with-upstash-token@your-instance.upstash.io:6379
