NODE_ENV=development
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pmm
JWT_SECRET=replace-with-a-long-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-long-random-secret
# false on local HTTP. Set true only when the API is served over HTTPS.
COOKIE_SECURE=false
BCRYPT_COST=10
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=2525
SMTP_SECURE=false
SMTP_USER=b9cba6001@smtp-brevo.com
SMTP_PASS=replace-with-brevo-smtp-key
EMAIL_FROM=Personal Money Manager <yourname@gmail.com>
REDIS_URL=rediss://default:replace-with-upstash-token@your-instance.upstash.io:6379
# Optional. Protects POST /api/internal/due-reminders if the host process sleeps at 08:00 IST.
CRON_SECRET=replace-with-a-long-random-secret
